From: Stefan Agner <stefan@agner.ch>
Subject: [PATCH] hostnamed: allow hostname change on read-only /etc

The implementation of write_string_file() with WRITE_STRING_FILE_ATOMIC
creates a temporary file next to the target, which fails when /etc is
read-only and only /etc/hostname is writable. Use a regular file write
and fsync the file, since WRITE_STRING_FILE_SYNC also tries to sync the
parent directory.

Rebased for systemd 258: the write goes through etc_hostname() now, and
the file descriptor open is checked before fsync().

Signed-off-by: Stefan Agner <stefan@agner.ch>
---
 src/hostname/hostnamed.c | 11 +++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

--- a/src/hostname/hostnamed.c
+++ b/src/hostname/hostnamed.c
@@ -23,6 +23,7 @@
 #include "env-file.h"
 #include "env-util.h"
 #include "extract-word.h"
+#include "fd-util.h"
 #include "fileio.h"
 #include "hashmap.h"
 #include "hostname-setup.h"
@@ -797,6 +798,7 @@
 
 static int context_write_data_static_hostname(Context *c) {
         _cleanup_(unset_statp) struct stat *s = NULL;
+        _cleanup_close_ int fd = -EBADF;
         int r;
 
         assert(c);
@@ -813,10 +815,18 @@
                 return 0;
         }
 
-        r = write_string_file(etc_hostname(), c->data[PROP_STATIC_HOSTNAME], WRITE_STRING_FILE_CREATE|WRITE_STRING_FILE_ATOMIC|WRITE_STRING_FILE_LABEL);
+        r = write_string_file(etc_hostname(), c->data[PROP_STATIC_HOSTNAME],
+                              WRITE_STRING_FILE_CREATE | WRITE_STRING_FILE_TRUNCATE);
         if (r < 0)
                 return r;
 
+        /* Cannot use WRITE_STRING_FILE_SYNC as it tries to sync parent dir */
+        fd = open(etc_hostname(), O_RDONLY|O_CLOEXEC);
+        if (fd < 0)
+                return -errno;
+        if (fsync(fd) < 0)
+                return -errno;
+
         TAKE_PTR(s);
         return 0;
 }
-- 
